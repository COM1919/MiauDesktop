<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MiauSettings.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MiauSettings"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <InfoBar x:Name="StatusBar"
                 Grid.Row="0"
                 Margin="12,8,12,0"
                 IsOpen="False"
                 IsClosable="True"
                 Severity="Error"
                 Title="未连接到 MiauDesktop" />

        <NavigationView x:Name="Nav"
                        Grid.Row="1"
                        PaneDisplayMode="Left"
                        OpenPaneLength="220"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        IsTitleBarAutoPaddingEnabled="False">

            <NavigationView.MenuItems>
                <NavigationViewItem Content="组件" Tag="components">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8B9;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="全局设置" Tag="global">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="位置调整" Tag="layout">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7C2;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="关于" Tag="about">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE946;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.PaneFooter>
                <StackPanel Margin="4,8,4,12" Spacing="8">
                    <Button x:Name="RefreshButton"
                            Content="刷新状态"
                            HorizontalAlignment="Stretch" />
                    <Button x:Name="ExitAppButton"
                            Content="退出 MiauDesktop"
                            HorizontalAlignment="Stretch" />
                </StackPanel>
            </NavigationView.PaneFooter>

            <NavigationView.Content>
                <ScrollViewer x:Name="ContentScroll"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="ContentHost"
                                Padding="36,20,36,32"
                                Spacing="0"
                                MaxWidth="900"
                                HorizontalAlignment="Left" />
                </ScrollViewer>
            </NavigationView.Content>
        </NavigationView>
    </Grid>
</Window>
